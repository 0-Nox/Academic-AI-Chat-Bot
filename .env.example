# Copy this file to .env and fill in real values. Never commit .env itself.

# Required — Gemini API key for embeddings + generation
GEMINI_API_KEY=YOUR_KEY_HERE

# MongoDB connection (local default works with `docker run -p 27017:27017 mongo`)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=academic_chatbot

# JWT signing secret — generate a real random value before any real deployment
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=120

# Optional overrides
EMBED_MODEL=gemini-embedding-001
GEN_MODEL=gemini-3.6-flash
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3
DATA_DIR=data
